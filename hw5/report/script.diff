+const INIT_SEED = 20260112;
+
+/**
+ * mulberry32 — a 32-bit PRNG used to shuffle the mini-batch order.
+ *
+ * `Math.random()` cannot be seeded, so the epoch shuffle would be the one
+ * remaining source of run-to-run drift. Four lines of arithmetic remove it.
+ *
+ * @param {number} seed
+ * @returns {() => number} generator of floats in [0, 1)
+ */
+function makeRng(seed) {
+  let a = seed >>> 0;
+  return function next() {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
