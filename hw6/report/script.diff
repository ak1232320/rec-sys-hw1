+  const nodes = Array.isArray(graph.movieNodes) ? graph.movieNodes : null;
+  const userCount = Array.isArray(graph.userIds)
+    ? graph.userIds.length
+    : Number(graph.nUsers) || 0;
+
+  for (let k = 0; k < movieIds.length; k++) {
+    const node = nodes ? Number(nodes[k]) : userCount + k;
+    const value = Number(p[node]);
+    out[k] = Number.isFinite(value) ? value : 0;
+  }
+  return out;
 }
 
